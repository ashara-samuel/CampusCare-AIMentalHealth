# Copy to .env and fill in. NEVER commit a real .env.

APP_ENV=development
DEBUG=true

# Generate a strong value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Dev default is SQLite; use Postgres in production, e.g.
# DATABASE_URL=postgresql+psycopg://campuscare:password@db:5432/campuscare
DATABASE_URL=sqlite:///./campuscare.db

# LLM provider (optional — without it, chat returns a safe fallback reply)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Voice output (optional — without it, /voice/speak returns 503 and the UI is text-only)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_monolingual_v1

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed browser origins (lock down for prod)
CORS_ORIGINS=["http://localhost:3000"]

RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

CRISIS_HOTLINE_REGION=international
